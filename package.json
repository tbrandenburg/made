{
  "name": "made",
  "private": true,
  "version": "0.1.7",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:frontend",
    "dev:frontend": "npm --workspace packages/frontend run dev",
    "build": "npm run build:frontend",
    "build:frontend": "npm --workspace packages/frontend run build",
    "test": "npm --workspace packages/frontend run test --",
    "test:watch": "npm --workspace packages/frontend run test -- --watch",
    "test:e2e": "playwright test",
    "lint": "npm --workspace packages/frontend run lint",
    "format": "npm --workspace packages/frontend run format"
  },
  "devDependencies": {
    "@playwright/test": "^1.43.1",
    "npm-run-all2": "^7.0.2",
    "wait-on": "^9.0.4"
  },
  "overrides": {
    "axios": ">=1.15.2",
    "picomatch": "4.0.7",
    "lodash": "4.18.1",
    "shell-quote": ">=1.11.0",
    "source-map-js": ">=1.2.2",
    "form-data": "4.0.6",
    "follow-redirects": ">=1.16.1",
    "qs": "6.16.1",
    "js-yaml": ">=4.3.2",
    "fast-uri": "^3.1.9 || ^4.2.3",
    "zod": "^4.6.6",
    "minimatch@3.1.5": {
      "brace-expansion": "^1.1.17"
    }
  }
}
